# Variables de entorno para la aplicación

# URL de la API de WooCommerce (reemplazar con la URL de tu tienda)
VITE_WOO_API_URL=https://tutienda.com/wp-json/wc/v3

# Credenciales de la API de WooCommerce
# Estas claves se generan en WooCommerce > Ajustes > Avanzado > API REST
VITE_WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ajustes de sincronización (opcional)
VITE_SYNC_ENABLED=false
VITE_SYNC_INTERVAL=5 # minutos